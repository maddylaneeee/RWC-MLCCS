<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RWC-MLCCS.Common</AssemblyName>
    <RootNamespace>RWC_MLCCS.Common</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RwcDefaultServerUrl Condition="'$(RwcDefaultServerUrl)' == ''">wss://lixinchen.ca/crc/v2/ws</RwcDefaultServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RwcDefaultServerUrl</_Parameter1>
      <_Parameter2>$(RwcDefaultServerUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
