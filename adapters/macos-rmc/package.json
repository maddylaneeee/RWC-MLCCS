{
  "name": "rmc-mlccs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote Mac Control for authorized MLCCS administration.",
  "bin": {
    "rmc-server": "./server/rmc-server.mjs"
  },
  "scripts": {
